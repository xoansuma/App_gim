### =====================================================
### FLUJO COMPLETO: Día de Pecho con Series
### =====================================================
### Ejecuta cada request en orden (Ctrl+Enter en cada uno)

### 1. CREAR USUARIO
POST http://localhost:8080/api/usuarios
Content-Type: application/json

{
  "email": "juan@gym.com",
  "nombre": "Juan Pérez",
  "password": "password123"
}

### 2. CREAR EJERCICIOS DE PECHO

# Press Banca
POST http://localhost:8080/api/ejercicios
Content-Type: application/json

{
  "nombre": "Press Banca",
  "grupoMuscular": "Pecho"
}

# Press Inclinado
POST http://localhost:8080/api/ejercicios
Content-Type: application/json

{
  "nombre": "Press Inclinado con Mancuernas",
  "grupoMuscular": "Pecho Superior"
}

# Aperturas
POST http://localhost:8080/api/ejercicios
Content-Type: application/json

{
  "nombre": "Aperturas con Mancuernas",
  "grupoMuscular": "Pecho"
}

# Fondos
POST http://localhost:8080/api/ejercicios
Content-Type: application/json

{
  "nombre": "Fondos en Paralelas",
  "grupoMuscular": "Pecho Inferior"
}

### 3. CREAR ENTRENAMIENTO "DÍA DE PECHO"
POST http://localhost:8080/api/entrenamientos
Content-Type: application/json

{
  "nombre": "Día de Pecho",
  "descripcion": "Rutina completa de pecho - 4 ejercicios",
  "usuarioId": 1,
  "fechaRealizacion": "2024-12-04T10:00:00"
}

### 4. AGREGAR EJERCICIOS AL ENTRENAMIENTO (PREDEFINIDO)

# Ejercicio 1: Press Banca
POST http://localhost:8080/api/ejercicios-entrenamientos
Content-Type: application/json

{
  "entrenamientoId": 1,
  "ejercicioId": 1,
  "orden": 1,
  "notas": "Calentar bien antes, ejercicio principal"
}

# Ejercicio 2: Press Inclinado
POST http://localhost:8080/api/ejercicios-entrenamientos
Content-Type: application/json

{
  "entrenamientoId": 1,
  "ejercicioId": 2,
  "orden": 2,
  "notas": "Trabajar pecho superior"
}

# Ejercicio 3: Aperturas
POST http://localhost:8080/api/ejercicios-entrenamientos
Content-Type: application/json

{
  "entrenamientoId": 1,
  "ejercicioId": 3,
  "orden": 3,
  "notas": "Estirar bien el pecho"
}

# Ejercicio 4: Fondos
POST http://localhost:8080/api/ejercicios-entrenamientos
Content-Type: application/json

{
  "entrenamientoId": 1,
  "ejercicioId": 4,
  "orden": 4,
  "notas": "Ejercicio de finalización"
}

### =====================================================
### AHORA EMPIEZAS A ENTRENAR - Añades series conforme las haces
### =====================================================

### 5. PRESS BANCA - Serie 1
POST http://localhost:8080/api/series
Content-Type: application/json

{
  "ejercicioEntrenamientoId": 1,
  "numeroSerie": 1,
  "repeticiones": 12,
  "peso": 60.0,
  "notas": "Calentamiento"
}

### PRESS BANCA - Serie 2
POST http://localhost:8080/api/series
Content-Type: application/json

{
  "ejercicioEntrenamientoId": 1,
